{
  "mcpServers": {
    "codanna-cc": {
      "command": "codanna",
      "args": ["--config", ".codanna/settings.toml", "serve", "--watch", "--watch-interval", "5"]
    },
    "codanna-cc-sse": {
      "type": "sse",
      "url": "http://127.0.0.1:8080/mcp/sse"
    },
    "codanna-cc-https": {
      "type": "sse",
      "url": "https://127.0.0.1:8443/mcp/sse"
    }
  }
}